  "engines": {
    "node": ">=24.22.1 <25"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "scripts": {
    "version": "node --input-type=module -e \"import { readFileSync, writeFileSync } from 'node:fs';\nimport manifest from './package.json' with { type: 'json' };\nconst readme = readFileSync('README.md', 'utf8');\nconst versionLine = /^Version \\x60[^\\x60\\r\\n]+\\x60\\./m;\nif (!versionLine.test(readme)) throw new Error('README.md is missing its version line');\nwriteFileSync('README.md', readme.replace(versionLine, 'Version \\x60' + manifest.version + '\\x60.'));\"",
    "start": "vite",
    "serve:dist": "vite preview",
    "build": "vite build",
    "lint": "eslint .",
    "test:integrity": "node --test tests/integrity/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/eva": "^1.2.3",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.46",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typograf": "^7.9.1",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.2",
    "@vueuse/core": "^15.0.0",
    "fitty": "^2.4.2",
    "gsap": "^3.15.1",
